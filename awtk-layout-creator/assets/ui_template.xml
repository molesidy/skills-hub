<?xml version="1.0" encoding="UTF-8"?>
<!--
  AWTK UI 模板（1.7.1 / release 2210）

  使用前必须修改：
    1. name：全局唯一，建议与文件名一致。
    2. w / h：默认 800x480，改成工程 LCD 尺寸。
    3. image="..."：换成 design/<theme>/images 下真实存在的资源名（不带路径/扩展名）。
    4. style="..."：换成 design/<theme>/styles/default.xml 中已定义的样式名，或删除（用内置默认样式）。

  规则速查：
    - x="c" / "center"、y="m" / "middle" 表示居中；x="r:20" 右对齐再左移 20。
    - w="100%"、h="100%" 取父控件尺寸；w="-20" 表示父宽减 20。
    - column/row 自己不会排布子控件，必须写 children_layout。
    - 资源名不要带 x1/ 路径或 .png 扩展名。
    - 图片控件默认 draw_type="default"；只有特殊控件（整屏背景/九宫格/平铺）才换其他值。
    - 切图文件名不得修改；XML 的 image 就是原始文件名主干。
    - 缺失切图不放置；错误切图/坐标照放，并写同名 .md。
    - 白天/黑夜双模式输出两个 XML；同模块控件可用 view 分组。
-->
<window name="main" x="0" y="0" w="800" h="480" style="default">
  <!-- 背景：整屏铺满。没有背景图时删除本行，用 style 的 bg_color。
       draw_type="fill" 属于特殊用途（平铺拉伸），已显式声明。 -->
  <image name="bg" x="0" y="0" w="100%" h="100%" image="bg_main" draw_type="fill"/>

  <!-- 同模块分组：一组切图共用一个 view，子控件用相对容器坐标。
       分组前后绝对坐标必须一致；不要为了结构好看而随意分组。 -->
  <view name="temp_group" x="53" y="54" w="59" h="26">
    <image name="temp_dash" x="0" y="1" w="12" h="19" draw_type="default" image="tem_n_dash"/>
    <image name="temp_value_1" x="12" y="1" w="12" h="19" draw_type="default" image="tem_n_2"/>
    <image name="temp_unit" x="36" y="1" w="21" h="22" draw_type="default" image="tem_ssd"/>
  </view>

  <!-- 内容区：vbox，四周 16px 边距，子控件间距 8px。 -->
  <view name="content" x="0" y="0" w="100%" h="100%"
        children_layout="default(r=0,c=1,s=8,m=16)">
    <label name="title" x="0" y="0" w="100%" h="36" text="Title"
           style.normal.text_color="#E6EDF3" style.normal.font_size="24"
           style.normal.text_align_h="left"/>

    <!-- 两列网格：2 行 2 列，间距 8，外边距 0。 -->
    <view name="grid" x="0" y="0" w="100%" h="300"
          children_layout="default(r=2,c=2,s=8,m=0)">
      <button name="btn_left" x="0" y="0" w="100%" h="100%" text="Left"/>
      <button name="btn_right" x="0" y="0" w="100%" h="100%" text="Right"/>
      <label name="hint" x="0" y="0" w="100%" h="100%" text="Hint"/>
      <label name="value" x="0" y="0" w="100%" h="100%" text="--"/>
    </view>

    <!-- 底部按钮行。 -->
    <view name="actions" x="0" y="0" w="100%" h="48"
          children_layout="default(r=1,c=2,s=8,m=0)">
      <button name="cancel" x="0" y="0" w="100%" h="100%" text="Cancel"/>
      <button name="ok" x="0" y="0" w="100%" h="100%" text="OK"/>
    </view>
  </view>
</window>
